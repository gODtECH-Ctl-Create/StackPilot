APP_NAME={{ project_name }}
APP_ENV=development
PORT=3000
{% if database == "PostgreSQL" %}DATABASE_URL=postgresql://stackpilot:stackpilot@localhost:5432/{{ project_name | replace("-", "_") }}
{% elif database == "MySQL" %}DATABASE_URL=mysql://stackpilot:stackpilot@localhost:3306/{{ project_name | replace("-", "_") }}
{% elif database == "MongoDB" %}DATABASE_URL=mongodb://localhost:27017/{{ project_name | replace("-", "_") }}
{% elif database == "SQLite" %}DATABASE_URL=sqlite://data/app.db
{% endif %}