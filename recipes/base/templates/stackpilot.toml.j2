version = 1

[project]
name = "{{ project_name }}"
kind = "{{ project_kind }}"
language = "{{ language }}"
framework = "{{ framework }}"
database = "{{ database }}"
cloud = "{{ cloud }}"

[features]
docker = {% if docker %}true{% else %}false{% endif %}
ci = {% if ci %}true{% else %}false{% endif %}
terraform = {% if terraform %}true{% else %}false{% endif %}

[stackpilot]
recipe = "{{ recipe_name }}"
